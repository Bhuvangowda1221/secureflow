# SecureFlow Environment Configuration
# Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ─── Flask Core ───────────────────────────────────────────────────────────────
SECRET_KEY=change-this-to-a-long-random-string-in-production
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_PORT=5000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=sqlite:///secureflow.db

# ─── GitHub Integration ───────────────────────────────────────────────────────
# Create a Personal Access Token at: https://github.com/settings/tokens
# Required scopes: repo, read:org
GITHUB_TOKEN=ghp_your_personal_access_token_here
GITHUB_WEBHOOK_SECRET=your_webhook_secret_here

# ─── SonarQube ────────────────────────────────────────────────────────────────
# Start SonarQube with Docker: docker run -d -p 9000:9000 sonarqube:community
SONARQUBE_URL=http://localhost:9000
SONARQUBE_TOKEN=your_sonarqube_token_here
SONARQUBE_PROJECT_KEY=secureflow

# ─── Security Settings ────────────────────────────────────────────────────────
# WTF CSRF
WTF_CSRF_ENABLED=True
WTF_CSRF_SECRET_KEY=another-random-secret-for-csrf

# Session security
SESSION_COOKIE_SECURE=False
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax

# Rate limiting
RATELIMIT_DEFAULT=200 per day;50 per hour

# ─── Scanner Paths ────────────────────────────────────────────────────────────
# Optional: override if tools are not on PATH
BANDIT_PATH=bandit
GITLEAKS_PATH=gitleaks
TRIVY_PATH=trivy
PIP_AUDIT_PATH=pip-audit

# ─── Application Settings ─────────────────────────────────────────────────────
# Directory where scanned repos are cloned (temp)
SCAN_WORKSPACE=./scan_workspace
# Directory where reports are saved
REPORTS_DIR=./reports
# Max concurrent scans
MAX_CONCURRENT_SCANS=3

# ─── Admin User (auto-created on first run) ───────────────────────────────────
ADMIN_EMAIL=admin@secureflow.local
ADMIN_PASSWORD=Admin@SecureFlow1

# ─── Email Notifications (optional) ──────────────────────────────────────────
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_app_password
